#!/bin/sh
# Blocks direct pushes to main and dev. Changes reach them only by pull request on GitHub.
# (GitHub branch protection needs GitHub Pro for private repositories – this is the local stand-in.)
# Turn on once per clone:  git config core.hooksPath .githooks
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/dev|refs/heads/uat)
      echo "Blocked: do not push to ${remote_ref#refs/heads/} directly. Push a feature/* or bugfix/* branch and open a pull request." >&2
      exit 1 ;;
  esac
done
exit 0
